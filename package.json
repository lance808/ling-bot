{
  "name": "ling-bot",
  "version": "0.1.0-p0",
  "private": true,
  "description": "Ling-bot —— 独立的 QQ 机器人桌面端（Tauri 2 + Node 后端，只借 SnowLuma 的 OneBot 接入面）",
  "type": "module",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "start": "node scripts/dev-desktop.mjs",
    "dev": "node scripts/dev-desktop.mjs",
    "backend": "node src/index.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "e2e:llm": "node scripts/llm-e2e.mjs",
    "e2e:real": "node scripts/e2e-real.mjs",
    "live": "node scripts/live-probe.mjs",
    "live:llm": "node scripts/live-llm.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "preflight": "node scripts/preflight.mjs",
    "icons": "node scripts/make-tauri-icons.mjs",
    "build:desktop": "cargo build --release --manifest-path desktop/Cargo.toml",
    "build:root-exe": "node scripts/build-root-exe.mjs",
    "bundle:desktop": "node scripts/bundle-desktop.mjs",
    "verify:node": "node scripts/verify-node.mjs"
  }
}
