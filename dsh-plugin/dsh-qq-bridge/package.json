{
  "name": "dsh-qq-bridge",
  "version": "0.1.0",
  "description": "把 DSH 的工具审批与会话控制暴露到 QQ：审批请求推到 QQ 由管理员决定，QQ 指令反过来让 DSH 干活。",
  "type": "module",
  "main": "./lib/index.js",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  }
}
